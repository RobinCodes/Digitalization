[Unit]
Description=SzigNotes — Digitalization knowledge index
Documentation=https://github.com/RobinCodes/Digitalization
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy

# server.js resolves Data/, DataHU/ and Music/ as ../Data etc., so the working
# directory must be Website/ inside the repo checkout — not the repo root.
WorkingDirectory=/opt/szignotes/Website
ExecStart=/usr/bin/node server.js

Environment=NODE_ENV=production
Environment=PORT=3000

# Without this every visitor shares one rate-limit budget, HSTS is never sent
# and the session cookie never gets its Secure flag. See hosting-and-operations.md §1.
Environment=TRUSTED_PROXIES=127.0.0.1

Environment=SITE_ORIGIN=https://szignotes.hu

# 4 vCPU box: two parallel pdflatex runs is the shipped default and fits fine.
# Drop to 1 if you ever move to a 2-vCPU plan.
Environment=COMPILE_CONCURRENCY=2

# Contact address the browser push services see (RFC 8292). Worth making real:
# some of them use it to reach you before they start refusing your pushes.
Environment=PUSH_SUBJECT=mailto:admin@szignotes.hu

# ── Admin webhook (optional) ─────────────────────────────────────────────────
# Where access requests, password resets, donations and sign-ups get announced, so
# somebody's request does not sit unseen for three days. Ordinary chat is never
# sent here. Uncomment and fill in — Discord, Slack and Telegram are auto-detected.
# The URL is a secret: prefer EnvironmentFile with a root-owned 0600 file over
# putting it in this unit, which is world-readable.
#
#   install -m 600 -o root -g root /dev/null /etc/szignotes.env
#   printf 'ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/…\n' >> /etc/szignotes.env
#
# EnvironmentFile=-/etc/szignotes.env
#
# Default detail is minimal: who did what, and a link. Set ADMIN_WEBHOOK_DETAIL=full
# to include note and donation titles — more useful, but those titles then live in a
# third party's chat log. See hosting-and-operations.md §6b.

Restart=always
RestartSec=2

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

# The app writes its JSON stores, Uploads/ and .pdf-cache/ here.
ReadWritePaths=/opt/szignotes/Website

[Install]
WantedBy=multi-user.target
