# This repo is authored on Windows and deployed to Linux. Anything the server
# executes or parses must keep LF endings regardless of the committer's
# core.autocrlf setting — a CRLF shebang fails as: bad interpreter: bash^M
*.sh              text eol=lf
*.service         text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
Deploy/Caddyfile  text eol=lf
